---
import MainLayout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/rocky-concrete/Hero.astro";
import Story from "../../components/rocky-concrete/Story.astro";
import Planning from "../../components/rocky-concrete/Planning.astro";
import BuildVsBuy from "../../components/rocky-concrete/BuildVsBuy.astro";
import Pipeline from "../../components/rocky-concrete/Pipeline.astro";
import OwnerExperience from "../../components/rocky-concrete/OwnerExperience.astro";
import Decisions from "../../components/rocky-concrete/Decisions.astro";
import Screenshots from "../../components/rocky-concrete/Screenshots.astro";
import Result from "../../components/rocky-concrete/Result.astro";
---

<MainLayout
  title="Rocky Concrete"
  description="A website for a Bakersfield concrete and landscaping contractor, built around a gallery he runs himself, from his phone, in Spanish."
>
  <Nav />

  <main class="bg-gray-50 min-h-screen">
    <Hero />

    <article class="max-w-5xl mx-auto px-6 pb-24">
      <Story />
      <Planning />
      <BuildVsBuy />
      <OwnerExperience />
      <Pipeline />
      <Decisions />
      <Screenshots />
      <Result />
    </article>
  </main>

  <Footer />
</MainLayout>
