      <text x="520" y="87" text-anchor="end" class="lbl-italic">cycles 2–10 (default)</text>

      <rect
        x="190"
        y="98"
        width="340"
        height="22"
        rx="4"
        fill="#ede9fe"
        stroke="#c4b5fd"></rect>
      <text
        x="200"
        y="113"
        font-size="11"
        font-family="monospace"
        fill="#5b21b6">Create driver</text
      >
      <text x="520" y="113" text-anchor="end" class="lbl-italic"
        >1st cycle, or if driver died</text
      >

      <rect
        x="190"
        y="124"
        width="340"
        height="22"
        rx="4"
        fill="#ede9fe"
        stroke="#c4b5fd"></rect>
      <text
        x="200"
        y="139"
        font-size="11"
        font-family="monospace"
        fill="#5b21b6">Login</text
      >
      <text x="520" y="139" text-anchor="end" class="lbl-italic"
        >1st cycle, or if logged out</text
      >

      <!-- arrow down to "do the work" -->
      <path
        d="M 360 160 L 360 188"
        class="arr"
        marker-end="url(#run-arrow)"></path>

      <!-- ===== do the work ===== -->
      <rect
        x="250"
        y="190"
        width="220"
        height="44"
        rx="8"
        fill="#ffffff"
        stroke="#d1d5db"></rect>
      <text
        x="360"
        y="208"
        text-anchor="middle"
        font-size="13"
        font-weight="600"
        fill="#111827">Do the work</text
      >
      <text x="360" y="224" text-anchor="middle" class="lbl-italic"
        >scrape · match · accept (see "How It Works")</text
      >

      <!-- arrow down to fork -->
      <path d="M 360 234 L 360 256" class="arr"></path>

      <!-- three-way fork lines -->
      <path d="M 130 256 L 590 256" class="arr"></path>
      <path
        d="M 130 256 L 130 278"
        class="arr"
        marker-end="url(#run-arrow)"></path>
      <path
        d="M 360 256 L 360 278"
        class="arr"
        marker-end="url(#run-arrow)"></path>
      <path
        d="M 590 256 L 590 278"
        class="arr"
        marker-end="url(#run-arrow)"></path>

      <!-- ===== SUCCESS COLUMN ===== -->
      <text x="130" y="294" text-anchor="middle" class="lbl">Success</text>

      <rect
        x="80"
        y="304"
        width="100"
        height="30"
        rx="6"
        fill="#ffffff"
        stroke="#d1d5db"></rect>
      <text
        x="130"
        y="324"
        text-anchor="middle"
        font-size="12"
        font-weight="600">Wait</text
      >

      <!-- Wait splits into 1-9 / 10 -->
      <path d="M 130 334 L 130 348" class="arr"></path>
      <path d="M 90 348 L 170 348" class="arr"></path>
      <path
        d="M 90 348 L 90 364"
        class="arr"
        marker-end="url(#run-arrow)"></path>
      <path
        d="M 170 348 L 170 364"
        class="arr"
        marker-end="url(#run-arrow)"></path>

      <!-- Runs 1-9 path -->
      <text x="90" y="379" text-anchor="middle" class="lbl-sub">Runs 1–9</text>
      <path d="M 90 385 L 90 528" class="arr-violet"></path>

      <!-- Run 10 path -> Destroy driver -->
      <text x="170" y="379" text-anchor="middle" class="lbl-sub">Run 10</text>
      <path
        d="M 170 385 L 170 400"
        class="arr"
        marker-end="url(#run-arrow)"></path>
      <rect
        x="125"
        y="402"
        width="90"
        height="28"
        rx="6"
        fill="#ede9fe"
        stroke="#a78bfa"></rect>
      <text
        x="170"
        y="421"
        text-anchor="middle"
        font-size="11"
        font-family="monospace"
        font-weight="600"
        fill="#5b21b6">Destroy driver</text
      >
      <text x="170" y="445" text-anchor="middle" class="lbl-italic"
        >contain memory leaks</text
      >
      <path d="M 170 450 L 170 528" class="arr-violet"></path>

      <!-- ===== TEMPERROR COLUMN ===== -->
      <text
        x="360"
        y="294"
        text-anchor="middle"
        class="lbl"
        style="fill:#a16207">TempError</text
      >

      <rect
        x="265"
        y="304"
        width="190"
        height="30"
        rx="6"
        fill="#fef9c3"
        stroke="#facc15"></rect>
      <text
        x="360"
        y="324"
        text-anchor="middle"
        font-size="12"
        font-weight="600"
        fill="#854d0e">1st or 2nd attempt?</text
      >

      <!-- splits into 1st / 2nd -->
      <path d="M 360 334 L 360 348" class="arr-yellow"></path>
      <path d="M 310 348 L 410 348" class="arr-yellow"></path>
      <path
        d="M 310 348 L 310 364"
        class="arr-yellow"
        marker-end="url(#run-arrow-yellow)"></path>
      <path
        d="M 410 348 L 410 364"
        class="arr-yellow"
        marker-end="url(#run-arrow-yellow)"></path>

      <!-- 1st: loops back to prepare_session -->
      <text
        x="310"
        y="379"
        text-anchor="middle"
        class="lbl-sub"
        style="fill:#854d0e">1st</text
      >
      <path d="M 310 385 L 310 528" class="arr-violet"></path>

      <!-- 2nd: raises PermanentError, routes RIGHT into the PermError column -->
      <text
        x="410"
        y="379"
        text-anchor="middle"
        class="lbl-sub"
        style="fill:#b91c1c">2nd</text
      >
      <path
        d="M 410 385 L 410 408 C 480 408, 540 408, 590 408"
        class="arr-red"
        marker-end="url(#run-arrow-red)"></path>
      <text
        x="500"
        y="400"
        text-anchor="middle"
        font-size="10"
        font-style="italic"
        fill="#b91c1c">raise PermanentError</text
      >

      <!-- ===== PERMERROR COLUMN ===== -->
      <text
        x="590"
        y="294"
        text-anchor="middle"
        class="lbl"
        style="fill:#b91c1c">PermError</text
