      <rect
        x="500"
        y="304"
        width="180"
        height="92"
        rx="8"
        fill="#fef2f2"
        stroke="#fca5a5"></rect>
      <text x="590" y="324" text-anchor="middle" font-size="11" fill="#7f1d1d"
        >Page structure changed,</text
      >
      <text x="590" y="341" text-anchor="middle" font-size="11" fill="#7f1d1d"
        >credentials invalid,</text
      >
      <text x="590" y="358" text-anchor="middle" font-size="11" fill="#7f1d1d"
        >or retries exhausted</text
      >
      <text x="590" y="382" text-anchor="middle" class="lbl-italic"
        >needs a human</text
      >

      <!-- PermError exit: red arrow down and out -->
      <path
        d="M 590 410 L 590 470"
        class="arr-red"
        stroke-width="2"
        marker-end="url(#run-arrow-red)"></path>
      <text
        x="590"
        y="490"
        text-anchor="middle"
        font-size="12"
        font-weight="700"
        fill="#b91c1c">Stop, notify both</text
      >
      <text x="590" y="506" text-anchor="middle" class="lbl-italic"
        >she accepts jobs herself while I fix it</text
      >

      <!-- ===== LOOP-BACK CONVERGENCE ===== -->
      <!-- per-feeder labels just above converge line -->
      <text x="90" y="520" text-anchor="middle" class="lbl-italic"
        >next cycle</text
      >
      <text x="170" y="520" text-anchor="middle" class="lbl-italic"
        >new session</text
      >
      <text x="310" y="520" text-anchor="middle" class="lbl-italic"
        >retry session</text
      >

      <!-- horizontal converge line at y=528 connecting all three feeders -->
      <path d="M 90 528 L 310 528" class="arr-violet"></path>

      <!-- big curve from leftmost converge point back up to prepare_session -->
      <path
        d="M 90 528 C 25 528, 25 90, 170 90"
        class="arr-violet"
        marker-end="url(#run-arrow-violet)"></path>

    </svg>
  </div>

  <p
    class="text-xs text-gray-400 italic text-center mt-4 max-w-2xl mx-auto"
  >
    Either the bot accepts the job, or she does. Either way, she doesn't
    miss it.
  </p>
</section>
