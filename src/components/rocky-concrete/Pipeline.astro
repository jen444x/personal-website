---
const photoSteps = [
  {
    label: "His iPhone",
    sub: "HEIC photos, on-site",
    color: "gray",
    icon: "phone",
  },
  {
    label: "Custom Upload",
    sub: "Simple form, HEIC→JPEG in-browser, Spanish-friendly",
    color: "violet",
    icon: "upload",
  },
  {
    label: "Sanity CMS",
    sub: "Embedded studio, schemas, references",
    color: "violet",
    icon: "cms",
  },
  {
    label: "SSR + CDN Cache",
    sub: "One config, two SLAs: ~1s for him, 30d for visitors",
    color: "violet",
    icon: "bolt",
  },
  {
    label: "Visitor's Browser",
    sub: "Instant load from warm cache",
    color: "gray",
    icon: "globe",
  },
];
---

<!-- The Pipeline (signature visual) -->
<section class="mb-24">
  <div class="mb-10">
    <span
      class="text-xs font-semibold text-amber-700 tracking-widest uppercase"
    >
      04 — The System
    </span>
    <h2 class="text-3xl font-bold text-gray-900 mt-2">
      A content pipeline from his iPhone to a visitor's browser.
    </h2>
    <p class="text-gray-600 leading-relaxed mt-4 text-lg max-w-3xl">
      The gallery has the most moving parts, so I built it as a pipeline and
      designed each layer around who's using it. He posts from the admin side,
      his customers browse from the public side, and the cache in the middle
      does the clever part: it serves both at once, with opposite goals.
    </p>
  </div>

  <!-- Diagram container -->
  <div
    class="bg-gradient-to-br from-gray-50 to-violet-50/40 rounded-3xl p-6 md:p-10 border border-gray-200"
  >
    <!-- Main flow: photos -->
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-4">
        <span
          class="px-2.5 py-1 bg-violet-100 text-violet-700 text-xs font-semibold rounded-full border border-violet-200"
        >
          PHOTO PATH
        </span>
      </div>

      <div
        class="flex flex-col md:flex-row items-stretch gap-3"
      >
        {
          photoSteps.map((step, i) => (
            <>
              <div
                class:list={[
                  "flex-1 bg-white rounded-2xl p-4 border shadow-sm",
                  step.color === "violet" && "border-violet-200",
                  step.color === "amber" && "border-amber-300",
                  step.color === "gray" && "border-gray-200",
                ]}
              >
                <div class="flex items-center gap-2 mb-1.5">
                  <div
                    class:list={[
                      "w-7 h-7 rounded-lg flex items-center justify-center shrink-0",
                      step.color === "violet" && "bg-violet-100",
                      step.color === "amber" && "bg-amber-100",
                      step.color === "gray" && "bg-gray-100",
                    ]}
                  >
                    {step.icon === "phone" && (
                      <svg
                        class:list={[
                          "w-4 h-4",
                          step.color === "violet" && "text-violet-600",
                          step.color === "amber" && "text-amber-700",
                          step.color === "gray" && "text-gray-600",
                        ]}
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                        />
                      </svg>
                    )}
                    {step.icon === "upload" && (
                      <svg
                        class:list={[
                          "w-4 h-4",
                          step.color === "violet" && "text-violet-600",
                        ]}
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
                        />
                      </svg>
                    )}
                    {step.icon === "cms" && (
                      <svg
                        class:list={[
                          "w-4 h-4",
                          step.color === "violet" && "text-violet-600",
                        ]}
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7c-2 0-3 1-3 3zm0 4h16M9 4v16"
                        />
                      </svg>
                    )}
                    {step.icon === "bolt" && (
                      <svg
                        class="w-4 h-4 text-violet-600"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M13 10V3L4 14h7v7l9-11h-7z"
                        />
                      </svg>
                    )}
                    {step.icon === "globe" && (
                      <svg
                        class="w-4 h-4 text-gray-600"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        />
                      </svg>
                    )}
                  </div>
                  <div class="text-gray-900 font-semibold text-sm">
                    {step.label}
                  </div>
                </div>
                <div class="text-gray-500 text-xs leading-snug">
                  {step.sub}
                </div>
              </div>
              {i < photoSteps.length - 1 && (
                <div class="flex items-center justify-center md:px-0 px-0">
                  <svg
                    class="w-5 h-5 text-gray-400 rotate-90 md:rotate-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2.5"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </div>
              )}
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>
