---
import Section from "./Section.astro";
import Wide from "./Wide.astro";
---

<!-- Result + Takeaway -->
<Section title="Result">
  <Wide class="grid md:grid-cols-2 gap-5 mb-8">
    <!-- Live link card -->
    <a
      href="https://rockyconcreteinc.com/"
      target="_blank"
      rel="noopener noreferrer"
      class="group relative overflow-hidden rounded-2xl border border-violet-200 bg-gradient-to-br from-violet-50 to-white p-6 shadow-sm hover:shadow-lg hover:border-violet-300 transition-all"
    >
      <div class="flex items-start justify-between mb-3">
        <div
          class="w-10 h-10 bg-violet-500 rounded-full flex items-center justify-center"
        >
          <svg
            class="w-5 h-5 text-white"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <svg
          class="w-5 h-5 text-violet-400 group-hover:text-violet-600 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          ></path>
        </svg>
      </div>
      <p class="text-xs font-semibold text-violet-700 uppercase tracking-wide mb-1">
        Live
      </p>
      <p class="text-gray-900 font-bold text-xl mb-2">
        rockyconcreteinc.com
      </p>
      <p class="text-gray-600 text-sm leading-relaxed">
        His primary digital presence. New customers land here before
        they call.
      </p>
    </a>

    <!-- Ownership card -->
    <div
      class="rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 to-white p-6 shadow-sm"
    >
      <div class="w-10 h-10 bg-amber-500 rounded-full flex items-center justify-center mb-3">
        <svg
          class="w-5 h-5 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
      </div>
      <p
        class="text-xs font-semibold text-amber-700 uppercase tracking-wide mb-1"
      >
        Hand-off
      </p>
      <p class="text-gray-900 font-bold text-xl mb-2">Runs without me</p>
      <p class="text-gray-600 text-sm leading-relaxed">
        He uploads from his phone whenever he finishes a job. The photos
        appear on the site within a second. No rebuilds, no support
        tickets.
      </p>
    </div>
  </Wide>

  <!-- Distilled takeaway -->
  <Wide
    class="relative bg-gray-900 rounded-2xl p-8 md:p-10 overflow-hidden"
  >
    <div
      class="absolute top-0 right-0 w-64 h-64 bg-violet-600/20 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl"
    >
    </div>

    <div class="relative">
      <p
        class="text-xs font-bold text-amber-400 tracking-widest uppercase mb-3"
      >
        The Takeaway
      </p>
      <p
        class="text-white text-2xl md:text-3xl font-semibold leading-snug max-w-3xl"
      >
        The best tool isn't the one with the most features. It's the one
        that fits the person who has to use it.
      </p>
      <p class="text-gray-400 text-sm mt-4 max-w-2xl leading-relaxed">
        Sanity had every feature I wanted; he needed something as simple as
        Instagram. So I built the simple thing on top of the powerful one, and
        everything underneath, the rendering, the cache, the image pipeline,
        exists so he never has to think about it.
      </p>
    </div>
  </Wide>
</Section>
