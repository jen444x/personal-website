---
const decisions = [
  {
    decision:
      "Converted gallery pages to SSR with a 1s/30d cache instead of triggering rebuilds on every upload.",
    why: "Prerendered pages meant every photo he posted needed a Netlify build (15 credits each) and didn't show up until the build finished. Wrong incentive for someone who uploads frequently. I swapped getStaticPaths for runtime category validation and set s-maxage=1, stale-while-revalidate=2592000. His edits propagate in ~1 second. Visitors hit warm cache for 30 days. Two SLAs, one cache pattern, no rebuilds.",
    label: "INFRASTRUCTURE",
    snippet: "Cache-Control: public, s-maxage=1, stale-while-revalidate=2592000",
  },
  {
    decision:
      "Picked Mux for video over native HTML5 once I tested on his actual phone.",
    why: "iOS Safari has its own playback rules (no autoplay without muted + playsinline, unreliable metadata events, weird first-frame behavior). I only caught it by testing on his actual phone, not a desktop browser pretending to be one. Native video kept breaking on the device that mattered most: his customers' phones. Mux handles adaptive bitrate, custom thumbnail timing, and the iOS quirks I would've had to patch myself.",
    label: "MEDIA",
    snippet: '<video muted playsinline preload="metadata" ... />',
  },
  {
    decision:
      "Organized the gallery by revenue, not upload chronology.",
    why: "Most contractor sites dump every photo into one grid sorted by date. That treats every job as equal. His high-revenue product lines (the work he books most often and that pays best) got promoted to their own top-level categories, with subcategories underneath. The gallery is a conversion surface, so the information architecture had to reflect what he's selling, not what he most recently uploaded.",
    label: "PRODUCT",
    snippet: null,
  },
];
---

<!-- Decisions -->
<section class="mb-24">
  <div class="mb-10">
    <span
      class="text-xs font-semibold text-amber-700 tracking-widest uppercase"
    >
      06 — Engineering Decisions
    </span>
    <h2 class="text-3xl font-bold text-gray-900 mt-2">
      Three more calls that shaped the build.
    </h2>
  </div>

  <div class="grid md:grid-cols-2 gap-5">
    {
      decisions.map((d) => (
        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm hover:shadow-md hover:border-violet-200 transition-all">
          <div class="inline-block px-2.5 py-1 bg-violet-100 text-violet-700 text-[10px] font-bold tracking-widest rounded-full border border-violet-200 mb-3">
            {d.label}
          </div>
          <h3 class="text-gray-900 font-semibold text-lg leading-snug mb-3">
            {d.decision}
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed">{d.why}</p>
          {d.snippet && (
            <div class="bg-gray-900 rounded-lg p-3 mt-4 overflow-x-auto">
              <code class="font-mono text-xs text-amber-200 whitespace-pre">
                {d.snippet}
              </code>
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>
